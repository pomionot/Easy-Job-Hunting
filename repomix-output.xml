              {message && (
                <div className={`p-4 rounded-xl mb-6 text-sm font-medium ${message.type === "success" ? "bg-emerald-50 border border-emerald-200 text-emerald-800" : "bg-rose-50 border border-rose-200 text-rose-800"}`} role="status">
