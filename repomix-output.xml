                className="rounded-xl bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-700"
              >
                キャンセル
              </button>
              <button
                type="submit"
                className="rounded-xl bg-orange-500 hover:bg-orange-600 px-4 py-2 text-sm font-semibold text-white"
              >
                保存
              </button>
            </div>
          </form>
        </div>
      )}
    </div>
  );
}
